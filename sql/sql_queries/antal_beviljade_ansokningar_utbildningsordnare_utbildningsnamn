SELECT UTBILDNINGSANORDNARE_ADMINISTR,
    UTBILDNINGSNAMN,
    COUNT (*) AS BEVILJADE_ANSOKNINGAR
FROM MYHDATATABLE
WHERE BESLUT = 'Beviljad'
    AND UTBILDNINGSOMRÅDE = 'Data/IT'
GROUP BY UTBILDNINGSANORDNARE_ADMINISTR,
    UTBILDNINGSNAMN
ORDER BY UTBILDNINGSANORDNARE_ADMINISTR,
    UTBILDNINGSNAMN;
